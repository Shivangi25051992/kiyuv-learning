{
  "name": "kiyuv-learning-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "functions"
  ],
  "scripts": {
    "dev": "npm --workspace @kiyuv/client run dev",
    "build": "npm --workspace @kiyuv/shared run build && npm --workspace @kiyuv/content run build && npm --workspace @kiyuv/functions run build && npm --workspace @kiyuv/client run build",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
